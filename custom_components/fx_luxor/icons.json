{
  "entity": {
    "button": {
      "illuminate_all": {
        "default": "mdi:lightbulb-group"
      },
      "extinguish_all": {
        "default": "mdi:lightbulb-group-off"
      }
    },
    "sensor": {
      "signal": {
        "default": "mdi:wifi"
      }
    },
    "select": {
      "theme": {
        "default": "mdi:lightbulb-group"
      }
    },
    "switch": {
      "flash_lights": {
        "default": "mdi:lightbulb-on-outline",
        "state": {
          "on": "mdi:flash"
        }
      }
    }
  },
  "services": {
    "create_theme": {
      "service": "mdi:lightbulb-group-outline"
    },
    "save_current_as_theme": {
      "service": "mdi:content-save"
    },
    "update_theme": {
      "service": "mdi:pencil"
    },
    "rename_theme": {
      "service": "mdi:rename"
    },
    "delete_theme": {
      "service": "mdi:delete"
    }
  }
}
